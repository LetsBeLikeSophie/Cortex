PORT=8787

# Anthropic (Claude) API key -- console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Optional: override the classification / sentence-search models
# (both default to claude-haiku-5-5).
# CLASSIFY_MODEL=claude-haiku-5-5
# SEARCH_MODEL=claude-haiku-5-5

# Supabase project -- Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: YouTube Data API v3 key (Google Cloud console). Lets YouTube
# links be tagged from the video's description/hashtags, not just its title.
YOUTUBE_API_KEY=
