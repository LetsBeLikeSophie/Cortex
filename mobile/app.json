{
  "expo": {
    "name": "Cortex",
    "slug": "cortex",
    "version": "1.0.0",
    "scheme": "cortex",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cortex"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/cortex"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cortex가 저장할 사진을 선택할 수 있도록 앨범 접근을 허용해주세요.",
          "cameraPermission": "Cortex로 촬영한 사진을 저장할 수 있도록 카메라 접근을 허용해주세요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "최근 스크린샷을 바로 불러와 저장할 수 있도록 사진첩 접근을 허용해주세요.",
          "savePhotosPermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["text/*", "image/*"],
          "disableIOS": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cortex가 음성을 듣고 글로 바꿀 수 있도록 마이크 접근을 허용해주세요.",
          "speechRecognitionPermission": "Cortex가 말한 내용을 인식할 수 있도록 음성 인식 접근을 허용해주세요."
        }
      ],
      "./plugins/withDisableAndroidBackup"
    ]
  }
}
